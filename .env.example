# ============================================
# Broker Configuration
# ============================================
# Copy this file to .env and fill in your credentials

# Active Broker Selection (angel, dhan, or fyers)
ACTIVE_BROKER=

# ============================================
# AngelOne (SmartAPI) Credentials
# ============================================
ANGEL_API_KEY=
# Note: Client Code, Password, and TOTP will be requested during authentication

# ============================================
# Dhan Securities Credentials
# ============================================
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_CLIENT_ID=

# ============================================
# Fyers Securities Credentials
# ============================================
FYERS_API_KEY=
FYERS_API_SECRET=

# ============================================
# Legacy Environment Variables (for backward compatibility)
# These will be set automatically based on ACTIVE_BROKER
# ============================================
# BROKER_API_KEY=
# BROKER_API_SECRET=
